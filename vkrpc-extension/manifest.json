{
  "manifest_version": 2,
  "name": "VKM RPC bridge",
  "version": "1.0.2",
  "description": "Reads the currently playing VK Music track from your own open tab and sends it to a local script for Discord Rich Presence. No permissions beyond running on vk.ru/vk.com.",
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["http://127.0.0.1/*", "tabs", "https://vk.ru/*", "https://vk.com/*"],
  "content_scripts": [
    {
      "matches": ["https://vk.ru/*", "https://vk.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{d4d309e2-37a3-436e-85e2-0a430356645a}",
      "strict_min_version": "78.0"
    }
  },
  "applications": {
    "gecko": {
      "id": "{d4d309e2-37a3-436e-85e2-0a430356645a}",
      "strict_min_version": "78.0"
    }
  }
}
